{
  "name": "opsbox",
  "version": "1.0.0",
  "description": "서버 정기점검 스크립트 생성·결과 수집·보고서",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-runtime-assets.js",
    "start": "node dist/server.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "demo:seed": "node scripts/demo.cjs seed",
    "demo:dev": "node scripts/demo.cjs dev",
    "demo:remove": "node scripts/demo.cjs remove",
    "test:e2e": "node --import tsx --test \"test/e2e/**/*.e2e.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0"
  },
  "overrides": {
    "content-disposition": "0.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
